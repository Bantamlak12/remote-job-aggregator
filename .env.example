# Copy to .env and fill in real values. Never commit .env.

# development | staging | production
APP_ENV=development

# Must be a postgres:// or postgresql:// URL.
DATABASE_URL=postgres://aggregator:aggregator@localhost:5432/aggregator

# Connection pool. Independent from any future HTTP/worker concurrency.
# MinConns is a floor pgxpool tries to keep warm, not a cap — pgxpool has
# no concept of a hard idle-connection ceiling.
DB_MAX_OPEN_CONNS=10
DB_MIN_CONNS=2
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

# debug | info | warn | error
LOG_LEVEL=info
# json | text
LOG_FORMAT=json

# How long graceful shutdown waits for active work before exiting anyway.
SHUTDOWN_TIMEOUT=15s

# Shared outbound HTTP client (discovery today; ATS ingestion in a later
# phase). MaxResponseBytes bounds bytes read, independent of Timeout
# bounding how long that read may take.
HTTP_TIMEOUT=10s
HTTP_MAX_RESPONSE_SIZE=5242880
HTTP_USER_AGENT=remote-job-aggregator/1.0 (+https://github.com/Bantamlak12/remote-job-aggregator)

# Bounded worker pool size for discovery, independent of DB/HTTP pool
# sizing above. 1-100.
DISCOVERY_WORKERS=5

# Used by "aggregator search-discover" (finds a company's ATS board via
# real web search, instead of a hand-curated seed file) and by the
# search-backed source of "aggregator ingest" (LinkedIn/Ethiojobs jobs of
# the priority companies). Without it, ingest simply skips that source.
#
# Setup (Serper's free tier: 2,500 queries, no credit card required):
#   1. https://serper.dev/ -> sign up -> copy the API key shown on your
#      dashboard (https://serper.dev/api-keys).
# That's it — unlike the Google Custom Search API this used to wrap,
# there is no second "search engine ID" to provision.
SERPER_API_KEY=

# Cap on Serper queries ONE "aggregator ingest" run may spend on the
# priority companies (2 per company, retries included; 25 companies need
# 50). The free tier is a fixed 2,500 queries, not a monthly allowance, so
# a mis-scheduled cron must not be able to burn it. 1-2500.
SEARCH_MAX_QUERIES_PER_RUN=60

# Only used by "aggregator serve" — the public, read-only job API
# backing the job-board frontend. Addr must be a valid host:port (bare
# ":PORT" binds all interfaces). CORS_ALLOWED_ORIGIN is a single
# explicit origin (never "*"); the default matches Vite's dev server.
API_ADDR=:8080
CORS_ALLOWED_ORIGIN=http://localhost:5173
# postgres (default): serve reads real ingested jobs. mock: serve returns
# 12 fixture jobs with no database needed (frontend development).
JOB_REPOSITORY=postgres

# Bounded worker pool for "aggregator ingest" (one ATS board fetched per
# worker at a time), independent of DB/HTTP/discovery pool sizing. 1-100.
INGESTION_WORKERS=5

# Ingestion's own HTTP limits. A real board fetched with content=true is
# far bigger than a discovery probe (measured: databricks, 883 jobs, is
# 9.7 MB decoded; stripe 5.4 MB) — larger than the shared 5 MiB
# HTTP_MAX_RESPONSE_SIZE default, which would fail those boards on every
# run. Bytes / duration.
INGESTION_MAX_RESPONSE_SIZE=33554432
INGESTION_HTTP_TIMEOUT=30s

# Only used by internal/database's integration tests (go test), never by
# the application itself. Must point at a database whose name ends in
# "_test" — these tests drop tables. docker-compose.yml provisions
# aggregator_test alongside the main aggregator database automatically.
TEST_DATABASE_URL=postgres://aggregator:aggregator@localhost:5432/aggregator_test
